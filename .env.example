# Copia este archivo como .env y llena los valores. Nunca versiones .env.
# En la VM: chmod 600 .env

GITHUB_TOKEN=

# Alertas por WhatsApp
# Proveedor: callmebot (gratuito) o meta (WhatsApp Cloud API)
WHATSAPP_PROVIDER=callmebot
WHATSAPP_ALERTAS=523340088294

# CallMeBot: envia "I allow callmebot to send me messages" al +34 644 51 95 23
# y copia aqui la apikey que te responde por WhatsApp.
CALLMEBOT_APIKEY=

# Meta WhatsApp Cloud API (alternativa oficial)
META_WA_TOKEN=
META_WA_PHONE_ID=
